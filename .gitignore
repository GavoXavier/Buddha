# Credentials. One file, four live secrets: Telegram bot token, chat id,
# Pocket Option SSID and uid. If this is ever committed the secrets are in the
# history for good, so it is listed first and it is the reason this file exists.
.env

# Local Claude Code settings
.claude/

# Runtime state and trading records — personal, not source
# (bot*.log* also catches bot.err.log and rotated copies: a log is not source,
# and a log is the one artefact most likely to be committed by accident.)
bot*.log*
*.contaminated-*
signals*.jsonl
stats*.json
winrate.json
# The markets this bot holds, so a restart resumes the same ones. Personal:
# which pairs are worth tracking is a decision, not source.
universe.json

# Market data. Regenerated at runtime; the 1-minute store is the archived
# history from before the period changed to 300s.
candles/
candles-1m-2026-09-15/
# The deep copy of the same bars, and the one thing here that is *not*
# regenerable: it is the only place a multi-day backtest sample can come from,
# and deleting it throws away history no feed will hand back.
candles-archive/

# Bytecode and test caches
__pycache__/
*.pyc
.pytest_cache/

# Scratch copies
*.bak
