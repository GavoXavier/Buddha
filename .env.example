# Copy to .env and fill in. Every value here is also the built-in default, so
# the bot runs with no .env at all (`FEED=simulated python main.py`).
# Anything that cannot work (a lead further back than one bar, an unreadable
# expiry) is rejected at startup with a message naming the variable.

# ===== Data feed =====
# simulated | pocket_option     (pocket_option needs the two credentials below)
FEED=simulated
POCKET_SSID=
POCKET_UID=0
POCKET_IS_DEMO=1
# Leave blank to let the SDK pick a region.
POCKET_REGION=

# ===== Markets =====
# Blank ASSETS = derive the universe from the feed's live asset list using the
# three settings below. A non-empty list is an instruction: those symbols, that
# order, payout floor ignored.
ASSETS=
ASSET_MODE=major          # major | forex | all
OTC_ONLY=1                # _otc assets trade 24/7 (they are the broker's own book)
MIN_PAYOUT=60             # skip markets paying less than this %

# ===== Bars and warm-up =====
# The bar length is the dial that sets the whole rhythm: one decision per bar.
# 300 gives 5-minute bars — a signal at 16:00 for an entry at 16:05. 60 is the
# original 1-minute cadence. Changing this discards the candle store, which is
# stamped with the period it was built at, so the engine starts cold (~90 min to
# the first possible signal on 5m bars, ~4h40m fully warm).
CANDLE_PERIOD=300         # seconds per bar — 300 for 5-minute trades
MAX_BARS=500              # bars held per market (also the candle-store depth);
                          # ~41h of history at 300s bars, ~8h at 60s
STALE_AFTER=420          # drop a market whose feed has been quiet this long.
                          # Must exceed CANDLE_PERIOD or a healthy market is
                          # dropped mid-bar: 420 suits a 300s bar, 120 a 60s one.
FEED_STALE_AFTER=90       # rebuild the whole session if NO market ticks for this long
MAX_GAP_BARS=5            # a feed outage longer than this many bars makes the bars
                          # either side of it two different series: the older side is
                          # dropped and the market warms up again. A window spanning
                          # the hole would otherwise read the whole outage as one
                          # bar's move. See market/aggregator.py. Counted in bars,
                          # so this tolerates 25 minutes at 300s and 5 at 60s.
PERSIST_CANDLES=1         # write bars to disk so a restart resumes warm
CANDLE_STORE_DIR=candles

# ===== Telegram =====
# Both are required for signals; with neither, signals are only logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Cadence =====
EXPIRY=5m                 # 1m | 5m | 1h | 90s — match it to CANDLE_PERIOD
# How far ahead of the entry the heads-up goes out. One whole bar is the longest
# allowed and it is a real limit: with lead == CANDLE_PERIOD the bot wakes on a
# boundary, judges the bar that just closed, and signals for the next one —
# signal 16:00, entry 16:05, expiry 16:10, one trade live at a time. A lead
# further back than that would make the run loop spin (see config.py).
SIGNAL_LEAD_SECONDS=300   # a whole bar
COOLDOWN_SECONDS=120      # a market sits out this long after signalling; a 300s
                          # rhythm never reaches it, but a 60s one does
MARTINGALE_STEPS=0        # extra entries appended to the message (0 = none)
MAX_CONSECUTIVE_LOSSES=5  # 0 disables the circuit breaker
BREAKER_PAUSE_MINUTES=15

# ===== Automated execution (demo only) =====
# Off by default. With it on the bot places the order itself on the signal's own
# boundary and reports what the broker actually paid, instead of only naming the
# second to trade. Refused unless FEED=pocket_option and POCKET_IS_DEMO=1: this
# build will not place orders on a funded account. That is also checked against
# the server's own answer at startup, so a live SSID mislabelled here cannot get
# past it — the bot says so in Telegram and carries on signal-only.
AUTO_TRADE=0
TRADE_AMOUNT=1.0          # stake per trade, in account currency

# ===== Selectivity =====
# These are the dials that decide how often the bot fires. Loosening them
# trades more often and less well; the replay tool reports which is binding:
#     python backtest.py
MIN_COMPONENTS=2          # directional indicators (RSI/MACD/BB/Stoch) that must be warm
MIN_SCORE=2               # weighted agreement needed (event vote 2, state vote 1)
TREND_FLAT_MIN_SCORE=3    # in a flat market demand this much; 9 = sit out ranges
MIN_CONFIDENCE=0.0        # 0..1 ranking floor applied to the winning setup

# ===== Trend filter =====
USE_TREND=1
TREND_EMA_LEN=50
TREND_SLOPE_BARS=5
TREND_MIN_DISTANCE_PCT=0.05

# ===== Higher-timeframe confirmation (built from the bar series) =====
USE_MTF=1
MTF_FACTOR=5              # 5 x 5m bars = a 25-minute confirmation at the default
                          # bar length; this was calibrated as 5 x 1m
MTF_EMA_LEN=10

# ===== Volatility band =====
USE_ATR=1
ATR_LEN=14
ATR_MIN_PCT=0             # 0 disables the floor
ATR_MAX_PCT=0             # 0 disables the ceiling

# ===== Indicators =====
USE_RSI=1
RSI_LEN=14
RSI_OB=70
RSI_OS=30

USE_MACD=1
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

USE_BB=1
BB_LEN=20
BB_MULT=2.0

USE_STOCH=1
STOCH_K=14
STOCH_D=3
STOCH_SMOOTH=3

USE_SR=1
SR_SWING_K=2
SR_PROXIMITY_PCT=0.1

# ===== Reporting =====
# The clock every rendered time is printed in — messages, /status, stats and the
# backtest listing. Set it to your own offset: a trade placed by hand has to land
# on the second the message names, so this must match the clock in front of you.
# Fixed offsets only (no DST). 3 = UTC+3 (Nairobi, the default).
MARKET_TZ_OFFSET_HOURS=3
STATS_PATH=stats.json
LEGACY_STATS_PATH=winrate.json   # imported once, if it exists
# Per-trade record of every signal, so `python reconcile.py` can check the bot's
# WIN/LOSS labels against the broker's own settlements. Without it there is
# nothing to reconcile — stats.json only keeps totals, not individual trades.
SIGNAL_JOURNAL_PATH=signals.jsonl
JOURNAL_SIGNALS=1
LOG_LEVEL=INFO
